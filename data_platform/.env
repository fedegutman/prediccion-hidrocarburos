# UID con el que Airflow escribe los archivos montados (evita problemas de permisos en Linux/Mac).
AIRFLOW_UID=50000

# Librerías que se instalan dentro de los contenedores de Airflow al arrancar:
#   dbt-core/dbt-postgres -> para transformar en el warehouse
#   pandas/requests -> para la extracción (Bronze)
# IMPORTANTE: pineamos dbt-core a 1.8.* para NO traer la 2.0 alpha (motor "Fusion",
# que todavía no soporta Postgres). Sin este pin, pip mete dbt-core 2.0.0a1 y rompe.
_PIP_ADDITIONAL_REQUIREMENTS=dbt-core==1.8.* dbt-postgres==1.8.* pandas requests
