global:
  resolve_timeout: 5m

route:
  group_by:
    - alertname
    - severity
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h
  receiver: slack-alertas

receivers:
  - name: slack-alertas
    slack_configs:
      - api_url: "${SLACK_WEBHOOK_URL}"
        send_resolved: true
        title: |
          {{ if eq .Status "firing" }}🔴 ALERTA: {{ .GroupLabels.alertname }}{{ else }}✅ RESUELTA: {{ .GroupLabels.alertname }}{{ end }}
        text: |
          {{ range .Alerts }}
          *{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          Severidad: {{ .Labels.severity }}
          {{ end }}
